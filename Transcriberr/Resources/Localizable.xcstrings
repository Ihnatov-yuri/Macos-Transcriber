            "value": "Читання всього запису… %lld%%"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hele opname lezen… %lld%%"
          }
        }
      }
    },
    "Reading the whole transcript…": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читання всього транскрипту…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het hele transcript lezen…"
          }
        }
