    },
    "Transcriberr Microphone for calls": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr Microphone для дзвінків"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr Microphone voor gesprekken"
          }
        }
      }
    },
    "Transcriberr closed while a meeting was recording. The %@ up to %@ are saved. Continue recording, and Stop joins the new part to it as one meeting.": {
      "comment": "Launch question after a crash; first value is a length like 23 minutes, second a time",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr закрився під час запису зустрічі. Те, що записано до %2$@ (%1$@), збережено. Продовжте запис, і «Зупинити» об’єднає нову частину з ним в одну зустріч."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr sloot terwijl er een vergadering werd opgenomen. Wat tot %2$@ is opgenomen (%1$@), is bewaard. Ga verder met opnemen, en Stop voegt het nieuwe deel ermee samen tot één vergadering."
          }
        }
      }
    },
    "Transcriberr closed while a recording was recording. The %@ up to %@ are saved. Continue recording, and Stop joins the new part to it as one recording.": {
      "comment": "Launch question after a crash; first value is a length like 23 minutes, second a time",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr закрився під час запису. Те, що записано до %2$@ (%1$@), збережено. Продовжте запис, і «Зупинити» об’єднає нову частину з ним в один запис."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr sloot terwijl er een opname liep. Wat tot %2$@ is opgenomen (%1$@), is bewaard. Ga verder met opnemen, en Stop voegt het nieuwe deel ermee samen tot één opname."
          }
        }
      }
    },
    "Transcriberr is up to date": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас остання версія Transcriberr"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr is bijgewerkt"
          }
        }
      }
    },
    "Transcriberr isn't running yet — open it once, then try again.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr ще не запущено — відкрийте його один раз і спробуйте знову."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr draait nog niet — open de app één keer en probeer het opnieuw."
