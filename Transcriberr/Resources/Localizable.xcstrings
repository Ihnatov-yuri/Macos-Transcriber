    "Download Whisper models ahead of time, or delete them to free disk space.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте моделі Whisper заздалегідь або видаліть їх, щоб звільнити місце на диску."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download Whisper-modellen vooraf, of verwijder ze om schijfruimte vrij te maken."
          }
        }
      }
    },
    "Download a text model": {
      "localizations": {
        "uk": {
          "stringUnit": {
