    "Each number is the average of your last %lld meetings. In all, %lld measured, %@ of your lines. Numbers come from the transcripts only; the text engine writes the goals' wording and tips.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне число — середнє за останніми зустрічами: %lld. Усього виміряно: %lld, ваших реплік: %@. Числа беруться лише з транскриптів; текстовий рушій формулює цілі й поради."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk getal is het gemiddelde van je laatste %lld vergaderingen. In totaal %lld gemeten, %@ van je regels. De cijfers komen alleen uit de transcripten; de tekstengine schrijft de formulering van de doelen en de tips."
          }
        }
      }
    },
    "Each number is the average over your latest %lld meetings (%@ to %@), out of %lld measured.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне число — середнє за останніми зустрічами: %lld (%@–%@); усього виміряно: %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk getal is het gemiddelde van je laatste %lld vergaderingen (%@ tot %@), van %lld gemeten."
          }
        }
      }
    },
    "Each number is the average over your latest %lld meetings in %@ (%@ to %@), out of %lld measured.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожне число — середнє за останніми зустрічами: %lld, мова — %@ (%@–%@); усього виміряно: %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk getal is het gemiddelde van je laatste %lld vergaderingen in het %@ (%@ tot %@), van %lld gemeten."
          }
        }
      }
    },
