    },
    "Showing every setting.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано всі налаштування."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle instellingen worden getoond."
          }
        }
      }
    },
    "Showing the settings most people change. Advanced adds Super tuning, prompts, voices, learned terms, API keys and AI assistants.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показано налаштування, які змінює більшість. «Розширені» додають налаштування Super, промпти, голоси, вивчені терміни, ключі API та ШІ-асистентів."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instellingen die de meeste mensen wijzigen worden getoond. Geavanceerd voegt Super-afstemming, prompts, stemmen, geleerde termen, API-sleutels en AI-assistenten toe."
          }
        }
      }
    },
    "Showing verbatim text. Switch to clean reading text.": {
      "localizations": {
        "uk": {
          "stringUnit": {
