        }
      }
    },
    "25 European languages — en, de, nl, fr, es, it, pt, pl, uk… (no Arabic/Asian)": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "25 європейських мов — en, de, nl, fr, es, it, pt, pl, uk… (без арабської та азійських)"
          }
        },
        "nl": {
