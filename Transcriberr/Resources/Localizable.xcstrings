          }
        }
      }
    },
    "As spoken": {
      "comment": "Dictation style: no rewrite, the words as said",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як сказано"
          }
        },
        "nl": {
