    "%@ is already saved. Use Merge into to make them one person.": {
      "comment": "Merge into is a button name",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже збережено. Скористайтеся «Приєднати до…», щоб зробити їх однією людиною."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is al bewaard. Gebruik Voeg samen met om er één persoon van te maken."
          }
        }
      }
    },
    "%@ is an Advanced setting, shown because it matches.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — розширене налаштування, показане, бо воно збігається."
