    },
    "Language on auto: follow the language of the text in the field": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова на «Авто»: брати мову тексту в полі"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taal op Auto: volg de taal van de tekst in het veld"
          }
        }
      }
    },
    "Language: %@.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Taal: %@."
          }
        }
      }
    },
    "Languages by engine": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мови за рушіями"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Talen per engine"
          }
        }
      }
    },
    "Last meeting": {
      "comment": "Person brief period",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остання зустріч"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatste vergadering"
          }
        }
      }
    },
    "Last month": {
      "comment": "Person brief period",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулий місяць"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgelopen maand"
          }
        }
      }
    },
    "Last read by an assistant %@.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Востаннє асистент читав бібліотеку %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatst gelezen door een assistent: %@."
          }
        }
      }
    },
    "Last said on": {
      "comment": "Person brief section: topics and what they last said about each",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Востаннє казали про"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laatst gezegd over"
          }
        }
      }
    },
    "Last week": {
      "comment": "Person brief period",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Минулий тиждень"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgelopen week"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пізніше"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Later"
          }
        }
      }
    },
    "Later recordings name these people on their own. Adding the same name again, from another recording or a new reading, makes their voice easier to find.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступні записи самі називатимуть цих людей. Якщо додати те саме ім’я ще раз — з іншого запису чи нового читання, — голос буде легше знайти."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Latere opnames noemen deze personen vanzelf. Dezelfde naam nog eens toevoegen, uit een andere opname of een nieuwe voorlezing, maakt hun stem makkelijker te vinden."
          }
        }
      }
    },
    "Learn from another recording, ideally one on a different microphone or a call.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчіть з іншого запису, бажано з іншим мікрофоном або з дзвінка."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer van een andere opname, liefst met een andere microfoon of van een gesprek."
          }
        }
      }
    },
    "Learn from the best recordings": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вчитися з найкращих записів"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer van de beste opnames"
          }
        }
      }
    },
    "Learn this voice": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчити цей голос"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer deze stem"
          }
        }
      }
    },
    "Learned before 5.0 (source not kept)": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчено до 5.0 (джерело не збережено)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geleerd vóór 5.0 (bron niet bewaard)"
          }
        }
      }
    },
    "Learned from %lld recordings or readings.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Learned from %lld recording or reading."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Learned from %lld recordings or readings."
                }
              }
            }
          }
        },
        "uk": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вивчено з %lld записів чи читань."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вивчено з %lld записів чи читань."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вивчено з %lld запису чи читання."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вивчено з %lld запису чи читання."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Geleerd uit %lld opname of voorlezing."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Geleerd uit %lld opnames of voorlezingen."
                }
              }
            }
          }
        }
      }
    },
    "Learned from %lld s of your voice on %@. Meetings find you on the mic by your voice. What the speakers play is never taken for you, your words survive when you talk over someone, and your voice coming back in the call audio is recognised as yours.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчено %2$@ з %1$lld с вашого голосу. Зустрічі знаходять вас на мікрофоні за голосом. Те, що грають динаміки, ніколи не приймається за вас, ваші слова зберігаються, коли ви говорите одночасно з кимось, а ваш голос, що повертається в аудіо дзвінка, розпізнається як ваш."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geleerd uit %lld s van je stem op %@. Vergaderingen vinden je op de microfoon aan je stem. Wat de luidsprekers afspelen, wordt nooit voor jou aangezien, je woorden blijven bewaard als je door iemand heen praat, en je stem die terugkomt in het gespreksgeluid, wordt als de jouwe herkend."
          }
        }
      }
    },
    "Learned from 1 recording or reading. Voices sound different on calls and in rooms; %lld is plenty.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчено з 1 запису чи читання. Голоси звучать по-різному у дзвінках і в кімнатах; %lld — цілком достатньо."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geleerd uit 1 opname of voorlezing. Stemmen klinken anders in gesprekken en in ruimtes; %lld is ruim genoeg."
          }
        }
      }
    },
    "Learned from your transcripts": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивчено з ваших транскриптів"
          }
