          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezien: %@. Tik om te starten, tik om te stoppen — of houd hem ingedrukt om te praten."
          }
        }
      }
    },
    "Send “%@” to the on-device text model as a request. You confirm each change.": {
