          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïnstalleerd"
          }
        }
      }
    },
    "Installed. Choose “%@” as the microphone in your call app.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлено. Виберіть «%@» як мікрофон у програмі для дзвінків."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïnstalleerd. Kies “%@” als microfoon in je bel-app."
          }
        }
      }
    },
    "Invite: %@": {
      "localizations": {
        "uk": {
          "stringUnit": {
