        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen transcript · start hierboven een transcriptie"
          }
        }
      }
    },
    "No voice in the %@ voice model yet. Improve from my recordings learns it from the meetings they are named in.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У моделі голосу %@ ще немає голосу. «Покращити з моїх записів» вивчить його із зустрічей, де названо цю людину."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen stem in het stemmodel %@. Verbeter uit mijn opnames leert hem uit de vergaderingen waarin ze benoemd zijn."
          }
        }
      }
    },
    "No {transcript_with_speakers} in the template, so the transcript is added at the end.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У промпті немає {transcript_with_speakers}, тож транскрипт додається в кінці."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen {transcript_with_speakers} in de prompt, dus het transcript wordt aan het eind toegevoegd."
          }
        }
      }
    },
    "No, this was someone else": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ні, це хтось інший"
