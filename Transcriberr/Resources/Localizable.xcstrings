        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш голос близький до голосу людини «%@», тож ваші репліки в записі можуть отримати ім’я «%@». Додайте читання, щоб вас розрізняли."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stem lijkt op die van %@, dus je regels in een opname kunnen de naam %@ krijgen. Voeg een voorlezing toe zodat jullie uit elkaar worden gehouden."
