      }
    },
    "Gemma 4 12B (more memory than Qwen 9B, no better), Qwen3.6 35B (good, but 22 GB), Qwen3 8B and Qwen3.5 4B (weaker), and Tiny Aya (weakest, and its licence forbids commercial use).": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 12B (більше пам’яті, ніж Qwen 9B, і не краща), Qwen3.6 35B (добра, але 22 ГБ), Qwen3 8B і Qwen3.5 4B (слабші) та Tiny Aya (найслабша, а її ліцензія забороняє комерційне використання)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 12B (meer geheugen dan Qwen 9B, niet beter), Qwen3.6 35B (goed, maar 22 GB), Qwen3 8B en Qwen3.5 4B (zwakker), en Tiny Aya (het zwakst, en de licentie verbiedt commercieel gebruik)."
          }
        }
      }
    },
    "Gemma 4 26B-A4B": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma 4 26B-A4B"
