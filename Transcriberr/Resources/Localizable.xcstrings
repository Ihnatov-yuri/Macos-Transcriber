    "Version %@ needs macOS %@ or later. Update macOS first; this version stays installed.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Версії %@ потрібна macOS %@ або новіша. Спершу оновіть macOS; ця версія залишається встановленою."
          }
        },
        "nl": {
          "stringUnit": {
