    "Found %@ in %lld recordings, %@ of speech. Transcriberr learns from the best %lld, using their longest clean stretches, and keeps only what clearly sounds like one person.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
