    },
    "Automatic (reads the text around the cursor)": {
      "comment": "Dictation spacing option",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично (зчитує текст довкола курсора)"
          }
        },
