{
  "sourceLanguage": "en",
  "strings": {
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - NSMicrophoneUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr records audio from your microphone to transcribe it locally on this Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr записує звук із мікрофона, щоб розпізнати мовлення тут, на цьому Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr neemt geluid van je microfoon op om het hier op deze Mac uit te schrijven."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy - NSCalendarsFullAccessUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr reads the invite of the meeting you recorded (its title and attendees) so their names are spelled right in the transcript. The invite is used on this Mac, and is sent to a cloud engine only when you choose one for a run."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr читає запрошення на записану зустріч (її назву та учасників), щоб їхні імена в транскрипті були написані правильно. Запрошення використовується на цьому Mac і надсилається до хмарного рушія, лише коли ви самі його обираєте."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr leest de uitnodiging van de vergadering die je opnam (de titel en de deelnemers), zodat hun namen goed in het transcript staan. De uitnodiging blijft op deze Mac en gaat alleen naar een cloudengine als je er zelf een kiest."
          }
        }
      }
    },
    "NSAudioCaptureUsageDescription": {
      "comment": "Privacy - NSAudioCaptureUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting mode records the audio other apps play (your meeting participants) so calls can be transcribed locally on this Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим зустрічі записує звук, який відтворюють інші програми (учасників вашої зустрічі), щоб розшифрувати дзвінок тут, на цьому Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vergadermodus neemt het geluid op dat andere apps afspelen (de deelnemers aan je vergadering), zodat gesprekken hier op deze Mac worden uitgeschreven."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription": {
      "comment": "Privacy - NSDocumentsFolderUsageDescription",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr saves recordings, transcripts, and sidecar files alongside your audio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr зберігає записи, транскрипти й супровідні файли поруч із вашим аудіо."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberr bewaart opnames, transcripten en bijbehorende bestanden naast je audio."
          }
        }
      }
    }
  },
  "version": "1.0"
}