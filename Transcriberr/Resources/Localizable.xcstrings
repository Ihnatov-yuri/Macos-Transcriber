            "state": "translated",
            "value": "Gemma 4 E4B"
          }
        }
      }
    },
    "Gemma and Qwen side by side: speed, quality and memory, measured. Download or delete each on-device model.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma і Qwen пліч-о-пліч: швидкість, якість і пам’ять, виміряні. Завантажуйте або видаляйте кожну модель на цьому Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemma en Qwen naast elkaar: snelheid, kwaliteit en geheugen, gemeten. Download of verwijder elk model op deze Mac."
          }
        }
      }
    },
    "Generate ↗": {
      "localizations": {
