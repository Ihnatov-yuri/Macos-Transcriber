    "Used for a run": {
      "comment": "Preset history: why this version was saved",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використано для запуску"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor een uitvoering"
          }
        }
      }
    },
    "Used for dictation, plain recordings and the meeting recorder.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується для диктування, звичайних записів і запису зустрічей."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor dicteren, gewone opnames en het opnemen van vergaderingen."
          }
        }
      }
    },
    "Used for dictation, plain recordings and the meeting recorder. System default or a chosen input device; a Bluetooth mic drops to hands-free while recording; loopback devices record system audio, not a room.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується для диктування, звичайних записів і запису зустрічей. Системний пристрій за замовчуванням або вибраний пристрій входу; Bluetooth-мікрофон під час запису переходить у режим гарнітури; loopback-пристрої записують системний звук, а не кімнату."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor dicteren, gewone opnamen en de vergaderrecorder. Systeemstandaard of een gekozen invoerapparaat; een Bluetooth-microfoon schakelt tijdens het opnemen naar handsfree; loopback-apparaten nemen systeemgeluid op, geen ruimte."
          }
        }
      }
    },
    "User template": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власний шаблон"
          }
        },
        "nl": {
