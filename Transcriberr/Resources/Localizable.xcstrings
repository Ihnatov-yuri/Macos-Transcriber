            "value": "Текстова модель для решти"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstmodel voor al het andere"
          }
        }
      }
    },
    "Text model not downloaded — inserted as spoken": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текстову модель не завантажено — вставлено як сказано"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekstmodel niet gedownload — ingevoegd zoals gezegd"
