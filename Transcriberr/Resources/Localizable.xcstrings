    "%@ is not downloaded yet, and no text model is: download one below. Until then summaries, titles, briefs and Super's rulings are off.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ще не завантажено, як і жодної текстової моделі: завантажте одну нижче. Доти підсумки, назви, довідки й рішення Super вимкнено."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is nog niet gedownload, en er is geen enkel tekstmodel: download er hieronder een. Tot dan staan samenvattingen, titels, briefings en de beslissingen van Super uit."
          }
        }
      }
    },
    "%@ is not downloaded yet: %@ does this until it is.": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
