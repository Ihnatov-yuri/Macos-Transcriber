    "%@ download": {
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ для завантаження"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ om te downloaden"
          }
        }
      }
    },
    "%@ failed (%d). If this is the first meeting recording, grant Transcriberr “System Audio Recording” in System Settings → Privacy & Security → Screen & System Audio Recording, then try again.": {
      "comment": "First value is a Core Audio step name in English, second an error code",
      "localizations": {
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: помилка (%d). Якщо це перший запис зустрічі, дозвольте Transcriberr «Запис системного аудіо» в Системних параметрах → Приватність і безпека → Запис екрана й системного аудіо, а потім спробуйте ще раз."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mislukt (%d). Als dit de eerste vergaderopname is, geef Transcriberr “Systeemaudio-opname” in Systeeminstellingen → Privacy en beveiliging → Scherm- en systeemaudio-opname en probeer het opnieuw."
          }
        }
      }
    },
